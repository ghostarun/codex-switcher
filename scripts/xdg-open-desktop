#!/usr/bin/env bash
# Restore the desktop environment for external apps launched from the AppDir.
unset APPDIR APPIMAGE LD_LIBRARY_PATH GSETTINGS_SCHEMA_DIR GTK_DATA_PREFIX GTK_EXE_PREFIX
unset GDK_PIXBUF_MODULE_FILE GTK_IM_MODULE_FILE GIO_MODULE_DIR GDK_BACKEND QT_QPA_PLATFORM
while IFS='=' read -r name value; do
  case "$name" in
    DISPLAY|XAUTHORITY|WAYLAND_DISPLAY|XDG_SESSION_TYPE|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS)
      export "$name=$value" ;;
  esac
done < <(/usr/bin/systemctl --user show-environment)
export XDG_DATA_DIRS=/usr/local/share:/usr/share:/var/lib/snapd/desktop
export PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
exec /usr/bin/xdg-open "$@"
