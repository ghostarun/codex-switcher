#!/usr/bin/env python3
"""codex_switcher usage — show 5h/weekly limits for all Codex accounts + Claude.

Read-only: Codex limits are fetched live from chatgpt.com (wham/usage) using the
account tokens in ~/.codex-switcher/accounts.json (--cached uses the app's cache); Claude data comes from the
Anthropic OAuth usage endpoint using the token in ~/.claude/.credentials.json.
Tokens are never refreshed or written.
"""
import json, os, re, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

CS = os.path.expanduser("~/.codex-switcher/accounts.json")
CL = os.path.expanduser("~/.claude/.credentials.json")
TTY = sys.stdout.isatty() and "NO_COLOR" not in os.environ

def col(s, c):
    return f"\033[{c}m{s}\033[0m" if TTY else s

def bar(used, w=20):
    left = 100 - max(0, min(100, used))
    n = round(w * left / 100)
    c = "32" if left > 40 else "33" if left > 15 else "31"
    return col("█" * n + "░" * (w - n), c) + f" {left:3.0f}% left"

def fmt_dur(sec):
    if sec <= 0: return "now"
    d, r = divmod(int(sec), 86400); h, r = divmod(r, 3600); m = r // 60
    return f"{d}d{h:02d}h" if d else f"{h}h{m:02d}m" if h else f"{m}m"

def row(label, used, reset_ts):
    rst = f"resets in {fmt_dur(reset_ts - time.time())}" if reset_ts else ""
    return f"    {label:<7}{bar(used)}  {rst}"

def live_codex(a):
    """Fetch live limits for one account; returns (quota_dict, error_str)."""
    t = (a.get("auth_json") or {}).get("tokens") or {}
    if not t.get("access_token"):
        return None, "no token"
    h = {"Authorization": "Bearer " + t["access_token"], "Accept": "application/json",
         "User-Agent": "codex_cli_rs/0.50.0", "originator": "codex_cli_rs"}
    if t.get("account_id"): h["ChatGPT-Account-Id"] = t["account_id"]
    err = None
    for i in range(3):
        try:
            j = json.load(urllib.request.urlopen(urllib.request.Request(
                "https://chatgpt.com/backend-api/wham/usage", headers=h), timeout=12))
            rl = j.get("rate_limit") or {}
            p, w = rl.get("primary_window") or {}, rl.get("secondary_window") or {}
            def at(x):
                return x.get("reset_at") or (time.time() + x["reset_after_seconds"] if x.get("reset_after_seconds") is not None else None)
            return {"five_hour_left": 100 - p.get("used_percent", 0), "five_hour_reset_at": at(p),
                    "weekly_left": 100 - w.get("used_percent", 0), "weekly_reset_at": at(w),
                    "plan_type": j.get("plan_type", "?")}, None
        except urllib.error.HTTPError as e:
            err = f"HTTP {e.code}"
            if e.code in (401, 403): break
        except Exception as e:
            err = str(e)[:40]
        time.sleep(1 << i)
    return None, err

def codex(live=True):
    try:
        d = json.load(open(CS))
    except Exception as e:
        print(f"Codex: cannot read {CS}: {e}"); return
    cur = d.get("current")
    print(col("Codex accounts", "1"))
    accts = d.get("accounts", [])
    accts = list(accts.values() if isinstance(accts, dict) else accts)
    fresh = {}
    if live:
        with ThreadPoolExecutor(8) as ex:
            fresh = dict(zip([a.get("id") for a in accts], ex.map(live_codex, accts)))
    for a in accts:
        q = a.get("cached_quota") or {}
        flags = []
        lq, lerr = fresh.get(a.get("id"), (None, None))
        if lq:
            q = {**q, **lq, "updated_at": None}
        elif live:
            flags.append(f"live failed: {lerr}, showing cached")
        if a.get("id") == cur: flags.append("active")
        if a.get("is_banned"): flags.append("BANNED")
        if a.get("is_token_invalid") or a.get("is_logged_out"): flags.append("needs login")
        age = None
        if q.get("updated_at"):
            t = datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", q["updated_at"]).replace("Z", "+00:00"))
            age = (datetime.now(timezone.utc) - t).total_seconds()
            if age > 900: flags.append(f"stale {fmt_dur(age)}")
        plan = q.get("plan_type", "?")
        print(f"  {a.get('name','?')} [{plan}]" + (f"  ({', '.join(flags)})" if flags else ""))
        if q.get("five_hour_left") is None:
            print("    no quota data yet"); continue
        h5r, wr = q.get("five_hour_reset_at"), q.get("weekly_reset_at")
        print(row("5h", 100 - q["five_hour_left"], h5r if (h5r or 0) > time.time() else None))
        print(row("weekly", 100 - q["weekly_left"], wr if (wr or 0) > time.time() else None))

def claude():
    print(col("Claude", "1"))
    try:
        c = json.load(open(CL))["claudeAiOauth"]
    except Exception as e:
        print(f"  cannot read credentials: {e}"); return
    if c["expiresAt"] / 1000 < time.time():
        print("  token expired — run `claude` once to refresh, then retry"); return
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": "Bearer " + c["accessToken"],
                 "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-code/2.0"})
    try:
        u = json.load(urllib.request.urlopen(req, timeout=15))
    except Exception as e:
        print(f"  usage request failed: {e}"); return
    print(f"  {c.get('subscriptionType','?')} plan")
    def ts(w):
        return datetime.fromisoformat(w["resets_at"]).timestamp() if w.get("resets_at") else None
    for key, label in (("five_hour", "5h"), ("seven_day", "weekly"),
                       ("seven_day_opus", "opus"), ("seven_day_sonnet", "sonnet")):
        w = u.get(key)
        if w and w.get("utilization") is not None:
            print(row(label, w["utilization"], ts(w)))

def main():
    if len(sys.argv) < 2 or sys.argv[1] != "usage":
        print("usage: codex_switcher usage [--cached]"); sys.exit(2)
    codex("--cached" not in sys.argv); print(); claude()

main()
